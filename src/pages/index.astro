---
import Base from '../layouts/Base.astro';
import Library from '../components/Library.astro';
import { SITE, getPosts } from '../lib/site';

const posts = await getPosts();
---
<Base>
  <div class="wrap">
    <div class="library-head">
      <div>
        <h1>Blog</h1>
        <p class="intro">By {SITE.author}.</p>
      </div>
    </div>
    <Library posts={posts} />
  </div>
</Base>
